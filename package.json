{
  "name": "personal-planner-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first Personal Planner for Linux Mint Desktop and Android",
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "scripts": {
    "android:run": "./run-android.sh",
    "live": "npm --prefix apps/desktop run dev -- --host",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "contracts:build": "npm --prefix packages/contracts run build"
  },
  "keywords": [
    "planner",
    "offline-first",
    "tauri",
    "android",
    "supabase"
  ],
  "author": "",
  "license": "MIT"
}
